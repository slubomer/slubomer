# Skopíruj tento súbor do .env a doplň hodnoty.
# .env nikdy necommituj (je v .gitignore). Sem patria len názvy premenných s prázdnymi hodnotami.

# --- Databáza (používa docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend ---
# Len ak backend spúšťaš mimo Dockeru, napr.:
# postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=
# true = podrobné chybové hlásenia (len lokálne)
DEBUG=
